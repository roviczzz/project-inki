{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inki",
  "version": "0.1.0",
  "identifier": "com.rovic.inki",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Inki",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
        "certificateThumbprint": "CBF9CB8B7E49BC66924B45A8B7BD92E64B2D2706",
        "digestAlgorithm": "sha256",
        "timestampUrl": "http://timestamp.comodoca.com",
        "tsp": false
    }
  }
}
